// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

// モデル定義
model gitHubRepo {
  id        String   @id @default(uuid())
  owner     String
  userId    String
  repo      String
  user      UserSetting @relation(fields: [userId], references: [userId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, owner, repo])
}
model UserSetting {
  id           String   @id @default(uuid())
  userId       String   @unique
  githubToken  String?  // 暗号化済み
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repos        gitHubRepo[]
}
model Todo {
  id        Int      @id @default(autoincrement())
  userId    String
  content   String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Afk {
  userId    String   @id
  reason    String   @default("AFK (離席中)")
  createdAt DateTime @default(now())
}